{
  "name": "its-my-go",
  "version": "0.1.0",
  "private": true,
  "description": "ItsMyGo 仓库根入口：npm 只做转发（部署走 deploy.sh / deploy.ps1，构建测试走 Maven 与 frontend）",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:api": "node scripts/mvn.mjs spring-boot:run",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm --prefix frontend run build",
    "build:api": "node scripts/mvn.mjs -Dmaven.test.skip=true package",
    "type-check": "npm --prefix frontend run type-check",
    "preview": "npm --prefix frontend run preview",
    "test": "node scripts/mvn.mjs test",
    "deploy": "node scripts/npm-deploy.mjs",
    "deploy:up": "node scripts/npm-deploy.mjs up",
    "deploy:down": "node scripts/npm-deploy.mjs down",
    "deploy:logs": "node scripts/npm-deploy.mjs logs",
    "deploy:status": "node scripts/npm-deploy.mjs status",
    "deploy:seed": "node scripts/npm-deploy.mjs seed",
    "deploy:reset": "node scripts/npm-deploy.mjs reset",
    "deploy:help": "node scripts/npm-deploy.mjs help"
  }
}
