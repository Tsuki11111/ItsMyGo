# 复制为 .env 并填入本地凭据；前后端共用本文件（Vite 只向浏览器暴露 VITE_ 前缀）。
# .env 已被 .gitignore 排除，不会入库。
DB_USERNAME=
DB_PASSWORD=
# HS256 要求至少 256 bit；生成方式：head -c 48 /dev/urandom | base64 | tr -d '\n'
JWT_SECRET=
# 本机共用 MinIO 实例的凭据（与 rag_helper 同一个）
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# 买小购客服智能体（rag_helper）gRPC；密钥取自 rag_helper/admin-key.txt，绝不入库
AGENT_GRPC_TARGET=127.0.0.1:8003
AGENT_GRPC_KEY=
AGENT_GRPC_DEADLINE_SECONDS=240
# 智能下单 / 退款动作（默认开启；设为 false 可一键停）
AGENT_ACTIONS_ENABLED=true
# 确认卡片有效期（秒），默认 600
AGENT_ACTION_EXPIRY_SECONDS=600

# 知识库导入服务（rag_helper 的 8001）。管理员在平台后台上传时由 Java 代理转发。
# AGENT_IMPORT_KEY 不填则复用上面的 AGENT_GRPC_KEY。
# AGENT_IMPORT_URL=http://127.0.0.1:8001
# AGENT_IMPORT_KEY=

# 首次部署的管理员引导：只有库中没有活跃 ADMIN 时才会创建，已有管理员绝不覆盖。
# 密码同样要求至少 8 位且同时包含字母和数字。
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
# 管理员邀请有效期（小时），默认 24
ADMIN_INVITE_EXPIRY_HOURS=24
# 虚拟物流送达时长（分钟）；默认 120，本地演示可设 2 看完整轨迹
LOGISTICS_DELIVERY_MINUTES=120
# 超时未支付订单自动取消：RabbitMQ 延迟消息 + 数据库扫描兜底
ORDER_TIMEOUT_MINUTES=30
ORDER_TIMEOUT_MQ_ENABLED=true
ORDER_TIMEOUT_SCAN_ENABLED=true
ORDER_TIMEOUT_SCAN_INTERVAL_MS=300000
ORDER_TIMEOUT_SCAN_LOCK_TTL_SECONDS=240
# RabbitMQ 本地账号（自己填，不要提交真实密码）
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=
# RABBITMQ_PASSWORD=

# 前端（Vite）：腾讯地图 Web 端（JavaScript API GL）Key
# 「解析坐标」还需要该 Key 开通 WebServiceAPI；未开通时地图仍能显示，收货地址退回城市中心兜底
VITE_TMAP_KEY=
