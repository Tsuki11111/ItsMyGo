# 复制为 .env 并填入本地凭据。.env 已被 .gitignore 排除，不会入库。
DB_USERNAME=
DB_PASSWORD=
# HS256 要求至少 256 bit；生成方式：head -c 48 /dev/urandom | base64 | tr -d '\n'
JWT_SECRET=
# 本机共用 MinIO 实例的凭据（与 rag_helper 同一个）
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# 买小购客服智能体（rag_helper）gRPC；密钥取自 rag_helper/admin-key.txt，绝不入库
AGENT_GRPC_TARGET=127.0.0.1:8003
AGENT_GRPC_KEY=
AGENT_GRPC_DEADLINE_SECONDS=240
# 智能下单 / 退款动作（默认开启；设为 false 可一键停）
AGENT_ACTIONS_ENABLED=true
# 确认卡片有效期（秒），默认 600
AGENT_ACTION_EXPIRY_SECONDS=600
# 虚拟物流送达时长（分钟）；默认 120，本地演示可设 2 看完整轨迹
LOGISTICS_DELIVERY_MINUTES=120
